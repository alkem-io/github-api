{
  "name": "@alkemio/github-api",
  "version": "0.1.0",
  "author": "Alkemio Foundation",
  "private": false,
  "license": "EUPL-1.2",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "data",
    "cli",
    "alkemio"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.prod.json",
    "prebuild": "npm run clean",
    "clean": "rimraf ./dist",
    "format": "prettier --write src/**/*.ts",
    "lint": "tsc --noEmit && eslint src/**/*.ts{,x}",
    "lint:fix": "tsc --noEmit && eslint src/**/*.ts{,x} --fix",
    "nodemon": "nodemon",
    "prepublishOnly": "npm run build",
    "codegen": "graphql-codegen --config codegen.yml",
    "repository-issues": "ts-node-dev src/scripts/repository-issues.ts",
    "capacity-planning": "ts-node-dev src/capacity-planning/capacity-planning.ts",
    "qa-analysis": "ts-node-dev src/qa-analysis/qa-analysis.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alkem-io/github-api.git"
  },
  "bugs": {
    "url": "https://github.com/alkem-io/github-api/issues"
  },
  "homepage": "https://github.com/alkem-io/github-api#readme",
  "devDependencies": {
    "@graphql-codegen/add": "6.0.0",
    "@graphql-codegen/cli": "6.0.0",
    "@graphql-codegen/typescript": "5.0.2",
    "@graphql-codegen/typescript-resolvers": "5.1.0",
    "@graphql-codegen/typescript-graphql-request": "^6.3.0",
    "@graphql-codegen/typescript-operations": "^5.0.2",
    "@types/node": "^22.17.0",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "ts-node-dev": "^2.0.0"
  },
  "dependencies": {
    "@alkemio/client-lib": "0.35.0",
    "dotenv": "^17.2.3",
    "graphql": "^16.11.0",
    "graphql-request": "^7.1.2",
    "graphql-tag": "^2.12.6",
    "nodemon": "^3.1.0",
    "winston": "^3.18.3",
    "xlsx": "^0.18.5"
  },
  "files": [
    "dist/**/*"
  ]
}
